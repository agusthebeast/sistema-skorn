rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function orderPath(orderId) { return /databases/$(database)/documents/ordenes/$(orderId); }
    function movementPath(orderId) { return /databases/$(database)/documents/movimientos/$("retiro_" + orderId); }

    // Se usa un único proyecto nuevo; nunca se consulta el Firebase viejo.
    // Catálogos compartidos: marcas, modelos, fallas y accesorios.
    // Los usuarios autenticados pueden incorporar términos nuevos sin abrir permisos públicos.
    match /catalogos/{catalogId} {
      allow read: if signed();
      allow create, update: if signed()
        && request.resource.data.tipo in ['marca','modelo','falla','accesorio']
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 90
        && request.resource.data.updatedBy == request.auth.token.email
        && (!exists(/databases/$(database)/documents/catalogos/$(catalogId))
          || request.resource.data.tipo == resource.data.tipo);
      allow delete: if false;
    }
    match /clientes/{clienteId} {
      allow read: if signed();
      // DNI real: id del documento = DNI.
      // SIN DNI: identificador interno reservado; no se inventan documentos nacionales.
      allow create: if signed()
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 180
        && request.resource.data.dni is string
        && (
          (request.resource.data.dni == clienteId && clienteId.matches('[0-9]{6,11}'))
          ||
          (clienteId.matches('sin-dni_[a-z0-9_-]+')
           && request.resource.data.dni == ''
           && request.resource.data.importadoSinDni == true)
        );
      allow update: if signed()
        && request.resource.data.dni == resource.data.dni
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0;
      allow delete: if false;
    }
    match /equipos/{equipoId} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.clienteId is string;
      allow update: if signed() && request.resource.data.clienteId == resource.data.clienteId;
      allow delete: if false;
    }
    match /ordenes/{orderId} {
      allow read: if signed();
      allow create: if signed()
        && request.resource.data.estado == 'Sin estado'
        && request.resource.data.presupuesto == null
        && request.resource.data.numero is string
        && request.resource.data.clienteId is string;
      allow update: if signed() && resource.data.estado != 'Entregado' && (
        // Edición regular: ninguna entrega se puede realizar mediante esta rama.
        (request.resource.data.estado != 'Entregado' && !('deliveryId' in request.resource.data))
        ||
        // Entrega, con orden y movimiento consistente en un mismo commit.
        (request.resource.data.estado == 'Entregado'
          && request.resource.data.deliveryId == orderId
          && resource.data.presupuesto is number
          && resource.data.presupuesto >= 0
          && request.resource.data.presupuesto == resource.data.presupuesto
          && request.resource.data.area == 'Salida'
          && (
            (resource.data.presupuesto == 0 && request.resource.data.movimientoCajaId == null)
            ||
            (resource.data.presupuesto > 0
              && request.resource.data.movimientoCajaId == 'retiro_' + orderId
              && getAfter(movementPath(orderId)).data.monto == resource.data.presupuesto
              && getAfter(movementPath(orderId)).data.ordenId == orderId)
          )
        )
      );
      allow delete: if false;
    }
    match /movimientos/{movId} {
      allow read: if signed();
      allow create: if signed()
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.cajaId is string
        && request.resource.data.pagos is map
        && (
          // Movimientos manuales y ventas.
          request.resource.data.origen in ['manual','venta_manual']
          ||
          // Cobro al entregar: no existe sin su orden actualizada.
          (request.resource.data.origen == 'retiro_orden'
            && movId == 'retiro_' + request.resource.data.ordenId
            && getAfter(orderPath(request.resource.data.ordenId)).data.estado == 'Entregado'
            && getAfter(orderPath(request.resource.data.ordenId)).data.movimientoCajaId == movId
            && getAfter(orderPath(request.resource.data.ordenId)).data.presupuesto == request.resource.data.monto)
          ||
          // Venta de productos: el recibo y la venta deben crearse juntos.
          (request.resource.data.origen == 'venta_producto'
            && movId == 'venta_' + request.resource.data.ventaId
            && getAfter(/databases/$(database)/documents/ventas/$(request.resource.data.ventaId)).data.movimientoId == movId
            && getAfter(/databases/$(database)/documents/ventas/$(request.resource.data.ventaId)).data.total == request.resource.data.monto)
        );
      allow update, delete: if false;
    }
    match /cajas/{cajaId} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.estado == 'abierta';
      allow update: if signed() && resource.data.estado == 'abierta'
        && request.resource.data.estado in ['abierta', 'cerrada']
        && request.resource.data.abiertaPor == resource.data.abiertaPor
        && request.resource.data.abiertaAt == resource.data.abiertaAt;
      allow delete: if false;
    }
    match /productos/{sku} {
      allow read: if signed();
      allow create: if signed()
        && request.resource.data.sku == sku
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.precioLista is number
        && request.resource.data.precioLista >= 0
        && request.resource.data.precioEfectivo is number
        && request.resource.data.precioEfectivo >= 0;
      allow update: if signed()
        && request.resource.data.sku == resource.data.sku
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.precioLista is number
        && request.resource.data.precioLista >= 0
        && request.resource.data.precioEfectivo is number
        && request.resource.data.precioEfectivo >= 0;
      allow delete: if false;
    }
    match /ventas/{ventaId} {
      allow read: if signed();
      allow create: if signed()
        && request.resource.data.movimientoId == 'venta_' + ventaId
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 60
        && getAfter(/databases/$(database)/documents/movimientos/$(request.resource.data.movimientoId)).data.ventaId == ventaId
        && getAfter(/databases/$(database)/documents/movimientos/$(request.resource.data.movimientoId)).data.monto == request.resource.data.total;
      allow update, delete: if false;
    }
    match /ajustesStock/{ajusteId} {
      allow read: if signed();
      allow create: if signed()
        && request.resource.data.usuario == request.auth.token.email
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() >= 4
        && request.resource.data.diferencia is int;
      allow update, delete: if false;
    }
    match /config/{id} {
      allow read: if signed();
      allow create, update: if signed() && id in ['cajaActual','contadores'];
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
